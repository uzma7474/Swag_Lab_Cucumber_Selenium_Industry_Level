<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

	<Properties>

		<Property name="LOG_PATTERN">
			%d{yyyy-MM-dd HH:mm:ss.SSS}
			[%t]
			%-5level
			%logger{36}
			-
			%msg%n
		</Property>

		<Property name="LOG_FILE">
			logs/automation.log
		</Property>

	</Properties>

	<Appenders>

		<!-- ============================== -->
		<!-- Console Appender               -->
		<!-- ============================== -->

		<Console name="Console"
			target="SYSTEM_OUT">

			<PatternLayout
				pattern="${LOG_PATTERN}" />

		</Console>


		<!-- ============================== -->
		<!-- Rolling File Appender          -->
		<!-- ============================== -->

		<RollingFile
			name="RollingFile"
			fileName="${LOG_FILE}"
			filePattern="logs/archive/automation-%d{yyyy-MM-dd}-%i.log.gz">

			<PatternLayout
				pattern="${LOG_PATTERN}" />

			<Policies>

				<!-- Create new log every day -->
				<TimeBasedTriggeringPolicy
					interval="1"
					modulate="true" />

				<!-- Create new file after 10 MB -->
				<SizeBasedTriggeringPolicy
					size="10 MB" />

			</Policies>

			<DefaultRolloverStrategy
				max="10" />

		</RollingFile>

	</Appenders>


	<Loggers>

		<!-- ============================== -->
		<!-- Application Logger             -->
		<!-- ============================== -->

		<Logger name="base" level="DEBUG" 	additivity="false">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Logger>

		<Logger name="driver" level="DEBUG" additivity="false">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Logger>

		<Logger name="pages" level="DEBUG" 	additivity="false">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Logger>

		<Logger name="actions" 	level="DEBUG" additivity="false">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Logger>

		<Logger name="hooks" level="DEBUG" 	additivity="false">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Logger>

		<Logger name="reports" level="DEBUG" additivity="false">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Logger>


		<!-- ============================== -->
		<!-- Root Logger                    -->
		<!-- ============================== -->

		<Root level="WARN">

			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />

		</Root>

	</Loggers>

</Configuration>